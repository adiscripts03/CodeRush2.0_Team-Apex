PORT=5000
HOST=0.0.0.0
NODE_ENV=production
MONGO_URI=mongodb://localhost:27017/disaster_command
JWT_SECRET=replace_with_a_strong_secret
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key
SUPABASE_PROJECT_ID=your_supabase_project_id
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_FUNCTION_NAME=make-server-12f1d05f
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# ─────────────────────────────────────────────────────────────
# x402 Payment Protocol Configuration
# ─────────────────────────────────────────────────────────────
# Master toggle (set to 'false' to disable payment protection)
X402_ENABLED=true

# Network (CAIP-2 identifier)
#   Base Sepolia (testnet): eip155:84532
#   Base Mainnet (production): eip155:8453
X402_NETWORK=eip155:84532

# Wallet address to receive payments (your address on Base Sepolia/Mainnet)
X402_PAY_TO=YOUR_WALLET_ADDRESS_HERE

# USDC contract address (auto-resolved from network if not set)
#   Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
#   Base Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Facilitator URL (auto-resolved from network if not set)
#   Testnet:    https://facilitator.x402.org
#   Production: https://facilitator.cdp.coinbase.com
# X402_FACILITATOR_URL=https://facilitator.x402.org

# CORS origin for frontend (default: * — restrict in production)
# CORS_ORIGIN=http://localhost:5173
